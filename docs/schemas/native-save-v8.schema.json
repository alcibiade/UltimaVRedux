{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/bradhannah/UltimaVRedux/main/docs/schemas/native-save-v8.schema.json",
  "title": "Native Ultima V Redux Save Schema",
  "description": "Strict native Ultima V Redux save envelope containing SaveSnapshot version 8, including persistent Shadowlord town assignments.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "envelopeVersion", "metadata", "snapshot"],
  "properties": {
    "format": {"const": "ultima5redux-native-snapshot"},
    "envelopeVersion": {"const": 1},
    "metadata": {
      "$ref": "native-save-v3.schema.json#/$defs/metadata"
    },
    "snapshot": {"$ref": "#/$defs/saveSnapshot"}
  },
  "$defs": {
    "saveSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version", "party", "inventory", "world", "progression", "effects", "wind", "random",
        "redux", "dungeon", "partyVehicle", "mapUnits", "itemStacks", "mapMutations"
      ],
      "properties": {
        "version": {"const": 8},
        "party": {
          "$ref": "native-save-v7.schema.json#/$defs/saveSnapshot/properties/party"
        },
        "inventory": {
          "$ref": "native-save-v7.schema.json#/$defs/saveSnapshot/properties/inventory"
        },
        "world": {
          "$ref": "native-save-v7.schema.json#/$defs/saveSnapshot/properties/world"
        },
        "progression": {"$ref": "#/$defs/progression"},
        "effects": {
          "$ref": "native-save-v7.schema.json#/$defs/saveSnapshot/properties/effects"
        },
        "wind": {
          "$ref": "native-save-v7.schema.json#/$defs/saveSnapshot/properties/wind"
        },
        "random": {
          "$ref": "native-save-v7.schema.json#/$defs/saveSnapshot/properties/random"
        },
        "redux": {
          "$ref": "native-save-v7.schema.json#/$defs/redux"
        },
        "dungeon": {
          "$ref": "native-save-v7.schema.json#/$defs/saveSnapshot/properties/dungeon"
        },
        "partyVehicle": {
          "$ref": "native-save-v7.schema.json#/$defs/saveSnapshot/properties/partyVehicle"
        },
        "mapUnits": {
          "$ref": "native-save-v7.schema.json#/$defs/saveSnapshot/properties/mapUnits"
        },
        "itemStacks": {
          "$ref": "native-save-v7.schema.json#/$defs/saveSnapshot/properties/itemStacks"
        },
        "mapMutations": {
          "$ref": "native-save-v7.schema.json#/$defs/saveSnapshot/properties/mapMutations"
        }
      },
      "allOf": [
        {"$ref": "native-save-v7.schema.json#/$defs/saveSnapshot/allOf/0"},
        {"$ref": "native-save-v7.schema.json#/$defs/saveSnapshot/allOf/1"},
        {"$ref": "native-save-v7.schema.json#/$defs/saveSnapshot/allOf/2"},
        {"$ref": "native-save-v7.schema.json#/$defs/saveSnapshot/allOf/3"},
        {"$ref": "native-save-v7.schema.json#/$defs/saveSnapshot/allOf/4"},
        {"$ref": "native-save-v7.schema.json#/$defs/saveSnapshot/allOf/5"},
        {"$ref": "native-save-v7.schema.json#/$defs/saveSnapshot/allOf/6"},
        {"$ref": "native-save-v7.schema.json#/$defs/saveSnapshot/allOf/7"},
        {"$ref": "native-save-v7.schema.json#/$defs/saveSnapshot/allOf/8"},
        {"$ref": "native-save-v7.schema.json#/$defs/saveSnapshot/allOf/9"},
        {"$ref": "native-save-v7.schema.json#/$defs/saveSnapshot/allOf/10"},
        {"$ref": "native-save-v7.schema.json#/$defs/saveSnapshot/allOf/11"}
      ]
    },
    "progression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "searchFound", "skullKeysFoundDay", "reagentCachesFoundDay", "moonstones", "shrines",
        "dungeons", "dungeonRooms", "shadowlords", "recipes", "hmsCapeActivated"
      ],
      "properties": {
        "searchFound": {
          "$ref": "native-save-v3.schema.json#/$defs/progression/properties/searchFound"
        },
        "skullKeysFoundDay": {
          "$ref": "native-save-v3.schema.json#/$defs/progression/properties/skullKeysFoundDay"
        },
        "reagentCachesFoundDay": {
          "$ref": "native-save-v3.schema.json#/$defs/progression/properties/reagentCachesFoundDay"
        },
        "moonstones": {
          "$ref": "native-save-v3.schema.json#/$defs/progression/properties/moonstones"
        },
        "shrines": {
          "$ref": "native-save-v3.schema.json#/$defs/progression/properties/shrines"
        },
        "dungeons": {
          "$ref": "native-save-v3.schema.json#/$defs/progression/properties/dungeons"
        },
        "dungeonRooms": {
          "$ref": "native-save-v3.schema.json#/$defs/progression/properties/dungeonRooms"
        },
        "shadowlords": {"$ref": "#/$defs/shadowlords"},
        "recipes": {
          "$ref": "native-save-v3.schema.json#/$defs/progression/properties/recipes"
        },
        "hmsCapeActivated": {
          "$ref": "native-save-v3.schema.json#/$defs/progression/properties/hmsCapeActivated"
        }
      }
    },
    "shadowlords": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alive", "townAssignments", "lastCalled", "summoned", "automaticPresence"],
      "properties": {
        "alive": {
          "$ref": "native-save-v3.schema.json#/$defs/shadowlords/properties/alive"
        },
        "townAssignments": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"type": "integer", "minimum": 0, "maximum": 8}
        },
        "lastCalled": {
          "$ref": "native-save-v3.schema.json#/$defs/shadowlords/properties/lastCalled"
        },
        "summoned": {
          "$ref": "native-save-v3.schema.json#/$defs/shadowlords/properties/summoned"
        },
        "automaticPresence": {
          "$ref": "native-save-v3.schema.json#/$defs/shadowlords/properties/automaticPresence"
        }
      },
      "allOf": [
        {"not": {"properties": {"townAssignments": {"contains": {"const": 1}, "minContains": 2}}}},
        {"not": {"properties": {"townAssignments": {"contains": {"const": 2}, "minContains": 2}}}},
        {"not": {"properties": {"townAssignments": {"contains": {"const": 3}, "minContains": 2}}}},
        {"not": {"properties": {"townAssignments": {"contains": {"const": 4}, "minContains": 2}}}},
        {"not": {"properties": {"townAssignments": {"contains": {"const": 5}, "minContains": 2}}}},
        {"not": {"properties": {"townAssignments": {"contains": {"const": 6}, "minContains": 2}}}},
        {"not": {"properties": {"townAssignments": {"contains": {"const": 7}, "minContains": 2}}}},
        {"not": {"properties": {"townAssignments": {"contains": {"const": 8}, "minContains": 2}}}},
        {
          "if": {"properties": {"alive": {"prefixItems": [{"const": false}]}}},
          "then": {"properties": {"townAssignments": {"prefixItems": [{"const": 0}]}}}
        },
        {
          "if": {"properties": {"alive": {"prefixItems": [{}, {"const": false}]}}},
          "then": {"properties": {"townAssignments": {"prefixItems": [{}, {"const": 0}]}}}
        },
        {
          "if": {"properties": {"alive": {"prefixItems": [{}, {}, {"const": false}]}}},
          "then": {"properties": {"townAssignments": {"prefixItems": [{}, {}, {"const": 0}]}}}
        }
      ]
    }
  }
}

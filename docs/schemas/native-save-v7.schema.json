{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/bradhannah/UltimaVRedux/main/docs/schemas/native-save-v7.schema.json",
  "title": "Native Ultima V Redux Save Schema",
  "description": "Strict native Ultima V Redux save envelope containing SaveSnapshot version 7, including durable generic player knowledge.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "envelopeVersion",
    "metadata",
    "snapshot"
  ],
  "properties": {
    "format": {
      "const": "ultima5redux-native-snapshot"
    },
    "envelopeVersion": {
      "const": 1
    },
    "metadata": {
      "$ref": "native-save-v3.schema.json#/$defs/metadata"
    },
    "snapshot": {
      "$ref": "#/$defs/saveSnapshot"
    }
  },
  "$defs": {
    "saveSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "party",
        "inventory",
        "world",
        "progression",
        "effects",
        "wind",
        "random",
        "redux",
        "dungeon",
        "partyVehicle",
        "mapUnits",
        "itemStacks",
        "mapMutations"
      ],
      "properties": {
        "version": {
          "const": 7
        },
        "party": {
          "$ref": "native-save-v6.schema.json#/$defs/saveSnapshot/properties/party"
        },
        "inventory": {
          "$ref": "native-save-v6.schema.json#/$defs/saveSnapshot/properties/inventory"
        },
        "world": {
          "$ref": "native-save-v6.schema.json#/$defs/saveSnapshot/properties/world"
        },
        "progression": {
          "$ref": "native-save-v6.schema.json#/$defs/saveSnapshot/properties/progression"
        },
        "effects": {
          "$ref": "native-save-v6.schema.json#/$defs/effects"
        },
        "wind": {
          "$ref": "native-save-v6.schema.json#/$defs/saveSnapshot/properties/wind"
        },
        "random": {
          "$ref": "native-save-v6.schema.json#/$defs/saveSnapshot/properties/random"
        },
        "redux": {
          "$ref": "#/$defs/redux"
        },
        "dungeon": {
          "$ref": "native-save-v6.schema.json#/$defs/saveSnapshot/properties/dungeon"
        },
        "partyVehicle": {
          "$ref": "native-save-v6.schema.json#/$defs/saveSnapshot/properties/partyVehicle"
        },
        "mapUnits": {
          "$ref": "native-save-v6.schema.json#/$defs/saveSnapshot/properties/mapUnits"
        },
        "itemStacks": {
          "$ref": "native-save-v6.schema.json#/$defs/saveSnapshot/properties/itemStacks"
        },
        "mapMutations": {
          "$ref": "native-save-v6.schema.json#/$defs/saveSnapshot/properties/mapMutations"
        }
      },
      "allOf": [
        {
          "$ref": "native-save-v6.schema.json#/$defs/saveSnapshot/allOf/0"
        },
        {
          "$ref": "native-save-v6.schema.json#/$defs/saveSnapshot/allOf/1"
        },
        {
          "$ref": "native-save-v6.schema.json#/$defs/saveSnapshot/allOf/2"
        },
        {
          "$ref": "native-save-v6.schema.json#/$defs/saveSnapshot/allOf/3"
        },
        {
          "$ref": "native-save-v6.schema.json#/$defs/saveSnapshot/allOf/4"
        },
        {
          "$ref": "native-save-v6.schema.json#/$defs/saveSnapshot/allOf/5"
        },
        {
          "$ref": "native-save-v6.schema.json#/$defs/saveSnapshot/allOf/6"
        },
        {
          "$ref": "native-save-v6.schema.json#/$defs/saveSnapshot/allOf/7"
        },
        {
          "$ref": "native-save-v6.schema.json#/$defs/saveSnapshot/allOf/8"
        },
        {
          "$ref": "native-save-v6.schema.json#/$defs/saveSnapshot/allOf/9"
        },
        {
          "$ref": "native-save-v6.schema.json#/$defs/saveSnapshot/allOf/10"
        },
        {
          "$ref": "native-save-v6.schema.json#/$defs/saveSnapshot/allOf/11"
        }
      ]
    },
    "redux": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reconstructMapUnits",
        "dungeonDiscoveries",
        "playerKnowledge"
      ],
      "properties": {
        "reconstructMapUnits": {
          "type": "boolean"
        },
        "dungeonDiscoveries": {
          "$ref": "native-save-v4.schema.json#/$defs/redux/properties/dungeonDiscoveries"
        },
        "playerKnowledge": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/playerKnowledgeEntry"
          }
        }
      }
    },
    "playerKnowledgeEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "key",
        "source",
        "discoveredOn",
        "unread",
        "spellFormula"
      ],
      "properties": {
        "category": {
          "const": "spell"
        },
        "key": {
          "enum": [
            "an-ylem",
            "in-xen-mani",
            "rel-xen-bet"
          ]
        },
        "source": {
          "$ref": "#/$defs/knowledgeSource"
        },
        "discoveredOn": {
          "oneOf": [
            {
              "$ref": "#/$defs/britannianDate"
            },
            {
              "type": "null"
            }
          ]
        },
        "unread": {
          "type": "boolean"
        },
        "spellFormula": {
          "$ref": "#/$defs/spellFormula"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "key": {
                "const": "an-ylem"
              },
              "spellFormula": {
                "type": "object",
                "properties": {
                  "state": {
                    "const": "confirmed"
                  }
                },
                "required": [
                  "state"
                ]
              }
            },
            "required": [
              "key",
              "spellFormula"
            ]
          },
          "then": {
            "properties": {
              "spellFormula": {
                "properties": {
                  "confirmedMask": {
                    "const": 20
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "key": {
                "const": "in-xen-mani"
              },
              "spellFormula": {
                "type": "object",
                "properties": {
                  "state": {
                    "const": "confirmed"
                  }
                },
                "required": [
                  "state"
                ]
              }
            },
            "required": [
              "key",
              "spellFormula"
            ]
          },
          "then": {
            "properties": {
              "spellFormula": {
                "properties": {
                  "confirmedMask": {
                    "const": 134
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "key": {
                "const": "rel-xen-bet"
              },
              "spellFormula": {
                "type": "object",
                "properties": {
                  "state": {
                    "const": "confirmed"
                  }
                },
                "required": [
                  "state"
                ]
              }
            },
            "required": [
              "key",
              "spellFormula"
            ]
          },
          "then": {
            "properties": {
              "spellFormula": {
                "properties": {
                  "confirmedMask": {
                    "const": 201
                  }
                }
              }
            }
          }
        }
      ]
    },
    "knowledgeSource": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "displayName"
          ],
          "properties": {
            "kind": {
              "const": "dialogue"
            },
            "displayName": {
              "type": "string",
              "pattern": "\\S"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "displayName"
          ],
          "properties": {
            "kind": {
              "const": "experimentation"
            },
            "displayName": {
              "const": "Experimentation"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "displayName"
          ],
          "properties": {
            "kind": {
              "const": "migration"
            },
            "displayName": {
              "const": "Previously learned; date unknown"
            }
          }
        }
      ]
    },
    "britannianDate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "year",
        "month",
        "day"
      ],
      "properties": {
        "year": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "month": {
          "type": "integer",
          "minimum": 1,
          "maximum": 13
        },
        "day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 28
        }
      }
    },
    "spellFormula": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "confirmedMask",
            "candidateMasks"
          ],
          "properties": {
            "state": {
              "const": "uncertain"
            },
            "confirmedMask": {
              "const": 0
            },
            "candidateMasks": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 255
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "confirmedMask",
            "candidateMasks"
          ],
          "properties": {
            "state": {
              "const": "confirmed"
            },
            "confirmedMask": {
              "type": "integer",
              "minimum": 1,
              "maximum": 255
            },
            "candidateMasks": {
              "type": "array",
              "maxItems": 0
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  }
}

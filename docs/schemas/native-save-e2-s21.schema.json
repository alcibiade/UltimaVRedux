{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/bradhannah/UltimaVRedux/main/docs/schemas/native-save-e2-s21.schema.json",
  "title": "Native Ultima V Redux Save Envelope 2 / Snapshot 21",
  "description": "Load frozen sibling s16-s20 schemas locally. Assert the journal formats using version-aware Go validators. Only moonstone origin retirement and current-placement survey semantics change from s20; all other finite domains are frozen.",
  "type": "object", "additionalProperties": false,
  "required": ["format", "envelopeVersion", "metadata", "snapshot"],
  "properties": {
    "format": {"const": "ultima5redux-native-snapshot"}, "envelopeVersion": {"const": 2},
    "metadata": {"$ref": "native-save-e2-s20.schema.json#/properties/metadata"},
    "snapshot": {"$ref": "#/$defs/snapshot"}
  },
  "$defs": {
    "snapshot": {
      "type": "object", "additionalProperties": false, "format": "ultima5-world-journal",
      "required": ["version", "party", "inventory", "world", "progression", "effects", "wind", "random", "continuation", "redux", "presentation", "lastConversation", "dungeonJournal", "moonstoneJournal", "atlasLandmarks", "dungeon", "partyVehicle", "mapUnits", "itemStacks", "mapMutations"],
      "properties": {
        "version": {"const": 21},
        "party": {"$ref": "native-save-e2-s20.schema.json#/$defs/snapshot/properties/party"},
        "inventory": {"$ref": "native-save-e2-s20.schema.json#/$defs/snapshot/properties/inventory"},
        "world": {"$ref": "native-save-e2-s20.schema.json#/$defs/snapshot/properties/world"},
        "progression": {"$ref": "native-save-e2-s20.schema.json#/$defs/snapshot/properties/progression"},
        "effects": {"$ref": "native-save-e2-s20.schema.json#/$defs/snapshot/properties/effects"},
        "wind": {"$ref": "native-save-e2-s20.schema.json#/$defs/snapshot/properties/wind"},
        "random": {"$ref": "native-save-e2-s20.schema.json#/$defs/snapshot/properties/random"},
        "continuation": {"$ref": "native-save-e2-s20.schema.json#/$defs/snapshot/properties/continuation"},
        "redux": {"$ref": "native-save-e2-s20.schema.json#/$defs/snapshot/properties/redux"},
        "presentation": {"$ref": "native-save-e2-s20.schema.json#/$defs/snapshot/properties/presentation"},
        "lastConversation": {"$ref": "native-save-e2-s20.schema.json#/$defs/snapshot/properties/lastConversation"},
        "dungeonJournal": {"$ref": "native-save-e2-s20.schema.json#/$defs/snapshot/properties/dungeonJournal"},
        "moonstoneJournal": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"$ref": "#/$defs/moonstoneObservation"}},
        "atlasLandmarks": {"$ref": "native-save-e2-s20.schema.json#/$defs/snapshot/properties/atlasLandmarks"},
        "dungeon": {"$ref": "native-save-e2-s20.schema.json#/$defs/snapshot/properties/dungeon"},
        "partyVehicle": {"$ref": "native-save-e2-s20.schema.json#/$defs/snapshot/properties/partyVehicle"},
        "mapUnits": {"$ref": "native-save-e2-s20.schema.json#/$defs/snapshot/properties/mapUnits"},
        "itemStacks": {"$ref": "native-save-e2-s20.schema.json#/$defs/snapshot/properties/itemStacks"},
        "mapMutations": {"$ref": "native-save-e2-s20.schema.json#/$defs/snapshot/properties/mapMutations"}
      },
      "allOf": [
        {"$ref": "native-save-e2-s20.schema.json#/$defs/snapshot/allOf/0"},
        {"$ref": "native-save-e2-s20.schema.json#/$defs/snapshot/allOf/1"},
        {"$ref": "native-save-e2-s20.schema.json#/$defs/snapshot/allOf/2"},
        {"$ref": "native-save-e2-s20.schema.json#/$defs/snapshot/allOf/3"},
        {"$ref": "native-save-e2-s20.schema.json#/$defs/snapshot/allOf/4"},
        {"$ref": "native-save-e2-s20.schema.json#/$defs/snapshot/allOf/5"},
        {"$ref": "native-save-e2-s20.schema.json#/$defs/snapshot/allOf/6"},
        {"$ref": "native-save-e2-s20.schema.json#/$defs/snapshot/allOf/7"},
        {"$ref": "native-save-e2-s20.schema.json#/$defs/snapshot/allOf/8"},
        {"$ref": "native-save-e2-s20.schema.json#/$defs/snapshot/allOf/9"},
        {"$ref": "native-save-e2-s20.schema.json#/$defs/snapshot/allOf/10"}
      ]
    },
    "moonstoneObservation": {
      "type": "object", "additionalProperties": false,
      "required": ["known", "firstSource", "discoveredAt", "siteKnown", "site", "placed", "lastContext", "observedAt", "survey", "surveyContext", "originalSiteRetired"],
      "properties": {
        "known": {"type": "boolean"},
        "firstSource": {"$ref": "native-save-e2-s20.schema.json#/$defs/moonstoneSource"},
        "discoveredAt": {"$ref": "native-save-e2-s20.schema.json#/$defs/optionalTime"},
        "siteKnown": {"type": "boolean"},
        "site": {"$ref": "native-save-e2-s20.schema.json#/$defs/site"},
        "placed": {"type": "boolean"},
        "lastContext": {"$ref": "native-save-e2-s20.schema.json#/$defs/moonstoneContext"},
        "observedAt": {"$ref": "native-save-e2-s20.schema.json#/$defs/optionalTime"},
        "survey": {"$ref": "native-save-e2-s20.schema.json#/$defs/survey"},
        "surveyContext": {"$ref": "native-save-e2-s20.schema.json#/$defs/moonstoneContext"},
        "originalSiteRetired": {"type": "boolean"}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/bradhannah/UltimaVRedux/main/docs/schemas/native-save-v3.schema.json",
  "title": "Native Ultima V Redux Save Schema",
  "description": "Strict native Ultima V Redux save envelope containing SaveSnapshot version 3. Future Redux-only fields must be introduced explicitly by a later snapshot schema version.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "envelopeVersion",
    "metadata",
    "snapshot"
  ],
  "properties": {
    "format": {
      "const": "ultima5redux-native-snapshot"
    },
    "envelopeVersion": {
      "const": 1
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "snapshot": {
      "$ref": "#/$defs/saveSnapshot"
    }
  },
  "$defs": {
    "byte": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "uint16": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "uint32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "uint64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "createdAt",
        "gameVersion"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "\\S"
        },
        "description": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "gameVersion": {
          "type": "string"
        }
      }
    },
    "saveSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "party",
        "inventory",
        "world",
        "progression",
        "effects",
        "wind",
        "random",
        "redux",
        "partyVehicle",
        "mapUnits",
        "itemStacks",
        "mapMutations"
      ],
      "properties": {
        "version": {
          "const": 3
        },
        "party": {
          "$ref": "#/$defs/party"
        },
        "inventory": {
          "$ref": "#/$defs/inventory"
        },
        "world": {
          "$ref": "#/$defs/world"
        },
        "progression": {
          "$ref": "#/$defs/progression"
        },
        "effects": {
          "$ref": "#/$defs/effects"
        },
        "wind": {
          "$ref": "#/$defs/wind"
        },
        "random": {
          "$ref": "#/$defs/random"
        },
        "redux": {
          "$ref": "#/$defs/redux"
        },
        "partyVehicle": {
          "oneOf": [
            {
              "$ref": "#/$defs/vehicle"
            },
            {
              "type": "null"
            }
          ]
        },
        "mapUnits": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/mapUnit"
          }
        },
        "itemStacks": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/itemStack"
          }
        },
        "mapMutations": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/mapMutation"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "redux": {
                "properties": {
                  "reconstructMapUnits": {
                    "const": true
                  }
                },
                "required": [
                  "reconstructMapUnits"
                ]
              }
            },
            "required": [
              "redux"
            ]
          },
          "then": {
            "properties": {
              "mapUnits": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "party": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roster",
        "karma",
        "metNpcs",
        "deadNpcs"
      ],
      "properties": {
        "roster": {
          "type": "array",
          "minItems": 16,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/character"
          }
        },
        "karma": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99
        },
        "metNpcs": {
          "type": [
            "array",
            "null"
          ],
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/npcFlag"
          }
        },
        "deadNpcs": {
          "type": [
            "array",
            "null"
          ],
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/npcFlag"
          }
        }
      }
    },
    "npcFlag": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "location",
        "npc"
      ],
      "properties": {
        "location": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31
        },
        "npc": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31
        }
      }
    },
    "character": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "occupied",
        "name",
        "gender",
        "class",
        "status",
        "strength",
        "dexterity",
        "intelligence",
        "currentMp",
        "currentHp",
        "maximumHp",
        "experience",
        "level",
        "monthsAtInn",
        "armorClass",
        "helmet",
        "armor",
        "weapon",
        "shield",
        "ring",
        "amulet",
        "partyMap"
      ],
      "properties": {
        "occupied": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "gender": {
          "type": "integer"
        },
        "class": {
          "type": "integer"
        },
        "status": {
          "type": "integer"
        },
        "strength": {
          "type": "integer"
        },
        "dexterity": {
          "type": "integer"
        },
        "intelligence": {
          "type": "integer"
        },
        "currentMp": {
          "type": "integer"
        },
        "currentHp": {
          "type": "integer"
        },
        "maximumHp": {
          "type": "integer"
        },
        "experience": {
          "type": "integer"
        },
        "level": {
          "type": "integer"
        },
        "monthsAtInn": {
          "type": "integer"
        },
        "armorClass": {
          "type": "integer"
        },
        "helmet": {
          "type": "integer"
        },
        "armor": {
          "type": "integer"
        },
        "weapon": {
          "type": "integer"
        },
        "shield": {
          "type": "integer"
        },
        "ring": {
          "type": "integer"
        },
        "amulet": {
          "type": "integer"
        },
        "partyMap": {
          "type": "integer"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "occupied": {
                "const": false
              }
            },
            "required": [
              "occupied"
            ]
          },
          "then": {
            "properties": {
              "name": {
                "const": ""
              },
              "gender": {
                "const": 0
              },
              "class": {
                "const": 0
              },
              "status": {
                "const": 0
              },
              "strength": {
                "const": 0
              },
              "dexterity": {
                "const": 0
              },
              "intelligence": {
                "const": 0
              },
              "currentMp": {
                "const": 0
              },
              "currentHp": {
                "const": 0
              },
              "maximumHp": {
                "const": 0
              },
              "experience": {
                "const": 0
              },
              "level": {
                "const": 0
              },
              "monthsAtInn": {
                "const": 0
              },
              "armorClass": {
                "const": 0
              },
              "helmet": {
                "const": 0
              },
              "armor": {
                "const": 0
              },
              "weapon": {
                "const": 0
              },
              "shield": {
                "const": 0
              },
              "ring": {
                "const": 0
              },
              "amulet": {
                "const": 0
              },
              "partyMap": {
                "const": 0
              }
            }
          },
          "else": {
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 9
              },
              "strength": {
                "$ref": "#/$defs/byte"
              },
              "dexterity": {
                "$ref": "#/$defs/byte"
              },
              "intelligence": {
                "$ref": "#/$defs/byte"
              },
              "currentMp": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "currentHp": {
                "$ref": "#/$defs/uint16"
              },
              "maximumHp": {
                "$ref": "#/$defs/uint16"
              },
              "experience": {
                "$ref": "#/$defs/uint16"
              },
              "level": {
                "type": "integer",
                "minimum": 1,
                "maximum": 255
              },
              "monthsAtInn": {
                "$ref": "#/$defs/byte"
              },
              "armorClass": {
                "$ref": "#/$defs/byte"
              },
              "helmet": {
                "$ref": "#/$defs/byte"
              },
              "armor": {
                "$ref": "#/$defs/byte"
              },
              "weapon": {
                "$ref": "#/$defs/byte"
              },
              "shield": {
                "$ref": "#/$defs/byte"
              },
              "ring": {
                "$ref": "#/$defs/byte"
              },
              "amulet": {
                "$ref": "#/$defs/byte"
              },
              "partyMap": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 40
                  },
                  {
                    "const": 127
                  },
                  {
                    "const": 255
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "food",
        "gold",
        "gems",
        "torches",
        "keys",
        "skullKeys",
        "equipment",
        "spells",
        "scrolls",
        "potions",
        "reagents",
        "questItems",
        "moonstones"
      ],
      "properties": {
        "food": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999
        },
        "gold": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999
        },
        "gems": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99
        },
        "torches": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99
        },
        "keys": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99
        },
        "skullKeys": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99
        },
        "equipment": {
          "type": "array",
          "minItems": 48,
          "maxItems": 48,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99
          }
        },
        "spells": {
          "type": "array",
          "minItems": 48,
          "maxItems": 48,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99
          }
        },
        "scrolls": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9999
          }
        },
        "potions": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99
          }
        },
        "reagents": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99
          }
        },
        "questItems": {
          "type": "array",
          "minItems": 14,
          "maxItems": 14,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99
          }
        },
        "moonstones": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99
          }
        }
      }
    },
    "world": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "lastLargeMapPosition",
        "calendar",
        "elapsedMs",
        "lastProcessedHour",
        "lastCamped",
        "lastWandererMonth",
        "combatSequence",
        "isSailing"
      ],
      "properties": {
        "position": {
          "$ref": "#/$defs/position"
        },
        "lastLargeMapPosition": {
          "$ref": "#/$defs/position"
        },
        "calendar": {
          "$ref": "#/$defs/calendar"
        },
        "elapsedMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "lastProcessedHour": {
          "type": "integer",
          "minimum": 0,
          "maximum": 23
        },
        "lastCamped": {
          "type": "integer",
          "minimum": 0
        },
        "lastWandererMonth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 13
        },
        "combatSequence": {
          "$ref": "#/$defs/uint64"
        },
        "isSailing": {
          "const": false
        }
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "location",
        "x",
        "y",
        "floor"
      ],
      "properties": {
        "location": {
          "$ref": "#/$defs/byte"
        },
        "x": {
          "$ref": "#/$defs/byte"
        },
        "y": {
          "$ref": "#/$defs/byte"
        },
        "floor": {
          "type": "integer",
          "minimum": -128,
          "maximum": 127
        }
      }
    },
    "calendar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "year",
        "month",
        "day",
        "hour",
        "minute",
        "turns"
      ],
      "properties": {
        "year": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "month": {
          "type": "integer",
          "minimum": 1,
          "maximum": 13
        },
        "day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 28
        },
        "hour": {
          "type": "integer",
          "minimum": 0,
          "maximum": 23
        },
        "minute": {
          "type": "integer",
          "minimum": 0,
          "maximum": 59
        },
        "turns": {
          "$ref": "#/$defs/uint32"
        }
      }
    },
    "progression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "searchFound",
        "skullKeysFoundDay",
        "reagentCachesFoundDay",
        "moonstones",
        "shrines",
        "dungeons",
        "dungeonRooms",
        "shadowlords",
        "recipes",
        "hmsCapeActivated"
      ],
      "properties": {
        "searchFound": {
          "type": "array",
          "minItems": 24,
          "maxItems": 24,
          "items": {
            "$ref": "#/$defs/byte"
          }
        },
        "skullKeysFoundDay": {
          "$ref": "#/$defs/byte"
        },
        "reagentCachesFoundDay": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/byte"
          }
        },
        "moonstones": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/moonstone"
          }
        },
        "shrines": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/shrine"
          }
        },
        "dungeons": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "type": "boolean"
          }
        },
        "dungeonRooms": {
          "type": "array",
          "minItems": 14,
          "maxItems": 14,
          "items": {
            "$ref": "#/$defs/byte"
          }
        },
        "shadowlords": {
          "$ref": "#/$defs/shadowlords"
        },
        "recipes": {
          "type": "array",
          "minItems": 48,
          "maxItems": 48,
          "items": {
            "$ref": "#/$defs/recipe"
          }
        },
        "hmsCapeActivated": {
          "type": "boolean"
        }
      }
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "known",
        "mask"
      ],
      "properties": {
        "known": {
          "type": "boolean"
        },
        "mask": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      }
    },
    "moonstone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "map",
        "level",
        "state",
        "isFound"
      ],
      "properties": {
        "x": {
          "$ref": "#/$defs/byte"
        },
        "y": {
          "$ref": "#/$defs/byte"
        },
        "map": {
          "$ref": "#/$defs/byte"
        },
        "level": {
          "$ref": "#/$defs/byte"
        },
        "state": {
          "enum": [
            0,
            1,
            255
          ]
        },
        "isFound": {
          "type": "boolean"
        }
      }
    },
    "shrine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active",
        "completed",
        "ruined"
      ],
      "properties": {
        "active": {
          "type": "boolean"
        },
        "completed": {
          "type": "boolean"
        },
        "ruined": {
          "type": "boolean"
        }
      }
    },
    "shadowlords": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alive",
        "lastCalled",
        "summoned",
        "automaticPresence"
      ],
      "properties": {
        "alive": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "boolean"
          }
        },
        "lastCalled": {
          "type": "integer",
          "minimum": -1,
          "maximum": 2
        },
        "summoned": {
          "type": "boolean"
        },
        "automaticPresence": {
          "type": "integer",
          "minimum": -1,
          "maximum": 2
        }
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "durationType",
        "durationTurns",
        "durationToggleOnly",
        "magicLightMinutesRemaining",
        "carriedTorchMinutesRemaining",
        "quicknessWorldActorSkip",
        "amulet",
        "crown",
        "badge"
      ],
      "properties": {
        "durationType": {
          "enum": [
            0,
            67,
            78,
            80,
            81,
            84
          ]
        },
        "durationTurns": {
          "type": "integer",
          "minimum": 0
        },
        "durationToggleOnly": {
          "const": false
        },
        "magicLightMinutesRemaining": {
          "type": "integer",
          "minimum": 0
        },
        "carriedTorchMinutesRemaining": {
          "type": "integer",
          "minimum": 0
        },
        "quicknessWorldActorSkip": {
          "type": "boolean"
        },
        "amulet": {
          "$ref": "#/$defs/toggle"
        },
        "crown": {
          "$ref": "#/$defs/toggle"
        },
        "badge": {
          "$ref": "#/$defs/toggle"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "durationType": {
                "const": 0
              }
            },
            "required": [
              "durationType"
            ]
          },
          "then": {
            "properties": {
              "durationTurns": {
                "const": 0
              }
            }
          },
          "else": {
            "properties": {
              "durationTurns": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      ]
    },
    "toggle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active",
        "turns"
      ],
      "properties": {
        "active": {
          "type": "boolean"
        },
        "turns": {
          "type": "integer",
          "minimum": 0
        }
      },
      "if": {
        "properties": {
          "active": {
            "const": false
          }
        },
        "required": [
          "active"
        ]
      },
      "then": {
        "properties": {
          "turns": {
            "const": 0
          }
        }
      }
    },
    "wind": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direction",
        "updateCounter",
        "nextTickMs"
      ],
      "properties": {
        "direction": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "updateCounter": {
          "type": "integer",
          "minimum": 0
        },
        "nextTickMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      }
    },
    "random": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seed",
        "sourceCalls"
      ],
      "properties": {
        "seed": {
          "$ref": "#/$defs/uint64"
        },
        "sourceCalls": {
          "$ref": "#/$defs/uint64"
        }
      }
    },
    "redux": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reconstructMapUnits"
      ],
      "properties": {
        "reconstructMapUnits": {
          "type": "boolean"
        }
      }
    },
    "vehicle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "currentDirection",
        "previousDirection",
        "skiffs",
        "ownedByNpc",
        "hull",
        "sailState",
        "hasHmsCape"
      ],
      "properties": {
        "type": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "currentDirection": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "previousDirection": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },

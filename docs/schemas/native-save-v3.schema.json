    "mapUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "world",
        "controllerOrder",
        "kind",
        "referenceId",
        "npcNum",
        "position",
        "visible",
        "skipNextTurn",
        "wantsToAutoTalk",
        "overriddenAi",
        "currentPath",
        "vehicle",
        "enemyVariant",
        "enemyCurrentHp",
        "enemyFacing",
        "shadowlord"
      ],
      "properties": {
        "world": {
          "type": "integer",
          "minimum": -1,
          "maximum": 0
        },
        "controllerOrder": {
          "type": "integer",
          "minimum": 0
        },
        "kind": {
          "enum": [
            "enemy",
            "npc",
            "vehicle"
          ]
        },
        "referenceId": {
          "type": "integer",
          "minimum": 0
        },
        "npcNum": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31
        },
        "position": {
          "$ref": "#/$defs/position"
        },
        "visible": {
          "type": "boolean"
        },
        "skipNextTurn": {
          "type": "boolean"
        },
        "wantsToAutoTalk": {
          "type": "boolean"
        },
        "overriddenAi": {
          "type": "integer"
        },
        "currentPath": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/position"
          }
        },
        "vehicle": {
          "oneOf": [
            {
              "$ref": "#/$defs/vehicle"
            },
            {
              "type": "null"
            }
          ]
        },
        "enemyVariant": {
          "enum": [
            "",
            "standard",
            "whirlpool",
            "pirate",
            "shadowlord"
          ]
        },
        "enemyCurrentHp": {
          "$ref": "#/$defs/uint16"
        },
        "enemyFacing": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "shadowlord": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 2
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "vehicle"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "vehicle": {
                "$ref": "#/$defs/vehicle"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "enemy"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "enemyVariant": {
                "enum": [
                  "standard",
                  "whirlpool",
                  "pirate",
                  "shadowlord"
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "enemyVariant": {
                      "enum": [
                        "standard",
                        "whirlpool"
                      ]
                    }
                  },
                  "required": [
                    "enemyVariant"
                  ]
                },
                "then": {
                  "properties": {
                    "enemyFacing": {
                      "const": 0
                    },
                    "shadowlord": {
                      "type": "null"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "enemyVariant": {
                      "const": "pirate"
                    }
                  },
                  "required": [
                    "enemyVariant"
                  ]
                },
                "then": {
                  "properties": {
                    "enemyFacing": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 4
                    },
                    "shadowlord": {
                      "type": "null"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "enemyVariant": {
                      "const": "shadowlord"
                    }
                  },
                  "required": [
                    "enemyVariant"
                  ]
                },
                "then": {
                  "properties": {
                    "enemyFacing": {
                      "const": 0
                    },
                    "shadowlord": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 2
                    }
                  }
                }
              }
            ]
          },
          "else": {
            "properties": {
              "enemyVariant": {
                "const": ""
              },
              "enemyCurrentHp": {
                "const": 0
              },
              "enemyFacing": {
                "const": 0
              },
              "shadowlord": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "itemStack": {
      "type": "object",
      "additionalProperties": false,
      "required": [

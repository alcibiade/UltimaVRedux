        "id": {
          "type": "integer",
          "minimum": 0
        },
        "quantity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "mapMutation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "kind",
        "value"
      ],
      "properties": {
        "position": {
          "$ref": "#/$defs/position"
        },
        "kind": {

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/bradhannah/UltimaVRedux/main/docs/schemas/native-save-v5.schema.json",
  "title": "Native Ultima V Redux Save Schema",
  "description": "Strict native Ultima V Redux save envelope containing SaveSnapshot version 5, including pending ship delivery state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "envelopeVersion",
    "metadata",
    "snapshot"
  ],
  "properties": {
    "format": {
      "const": "ultima5redux-native-snapshot"
    },
    "envelopeVersion": {
      "const": 1
    },
    "metadata": {
      "$ref": "native-save-v3.schema.json#/$defs/metadata"
    },
    "snapshot": {
      "$ref": "#/$defs/saveSnapshot"
    }
  },
  "$defs": {
    "saveSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "party",
        "inventory",
        "world",
        "progression",
        "effects",
        "wind",
        "random",
        "redux",
        "dungeon",
        "partyVehicle",
        "mapUnits",
        "itemStacks",
        "mapMutations"
      ],
      "properties": {
        "version": {
          "const": 5
        },
        "party": {
          "$ref": "native-save-v4.schema.json#/$defs/saveSnapshot/properties/party"
        },
        "inventory": {
          "$ref": "native-save-v4.schema.json#/$defs/saveSnapshot/properties/inventory"
        },
        "world": {
          "$ref": "native-save-v4.schema.json#/$defs/saveSnapshot/properties/world"
        },
        "progression": {
          "$ref": "native-save-v4.schema.json#/$defs/saveSnapshot/properties/progression"
        },
        "effects": {
          "$ref": "native-save-v4.schema.json#/$defs/saveSnapshot/properties/effects"
        },
        "wind": {
          "$ref": "native-save-v4.schema.json#/$defs/saveSnapshot/properties/wind"
        },
        "random": {
          "$ref": "native-save-v4.schema.json#/$defs/saveSnapshot/properties/random"
        },
        "redux": {
          "$ref": "native-save-v4.schema.json#/$defs/redux"
        },
        "dungeon": {
          "$ref": "native-save-v4.schema.json#/$defs/saveSnapshot/properties/dungeon"
        },
        "partyVehicle": {
          "oneOf": [
            {
              "allOf": [
                {
                  "$ref": "#/$defs/vehicle"
                },
                {
                  "properties": {
                    "pendingDelivery": {
                      "const": false
                    }
                  }
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "mapUnits": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/mapUnit"
          }
        },
        "itemStacks": {
          "$ref": "native-save-v4.schema.json#/$defs/saveSnapshot/properties/itemStacks"
        },
        "mapMutations": {
          "$ref": "native-save-v4.schema.json#/$defs/saveSnapshot/properties/mapMutations"
        }
      },
      "allOf": [
        {
          "$ref": "native-save-v4.schema.json#/$defs/saveSnapshot/allOf/0"
        },
        {
          "$ref": "native-save-v4.schema.json#/$defs/saveSnapshot/allOf/1"
        },
        {
          "$ref": "native-save-v4.schema.json#/$defs/saveSnapshot/allOf/2"
        },
        {
          "$ref": "native-save-v4.schema.json#/$defs/saveSnapshot/allOf/3"
        },
        {
          "$ref": "native-save-v4.schema.json#/$defs/saveSnapshot/allOf/4"
        },
        {
          "$ref": "native-save-v4.schema.json#/$defs/saveSnapshot/allOf/5"
        },
        {
          "$ref": "native-save-v4.schema.json#/$defs/saveSnapshot/allOf/6"
        },
        {
          "$ref": "native-save-v4.schema.json#/$defs/saveSnapshot/allOf/7"
        },
        {
          "$ref": "native-save-v4.schema.json#/$defs/saveSnapshot/allOf/8"
        },
        {
          "$ref": "native-save-v4.schema.json#/$defs/saveSnapshot/allOf/9"
        },
        {
          "properties": {
            "mapUnits": {
              "contains": {
                "type": "object",
                "properties": {
                  "vehicle": {
                    "type": "object",
                    "properties": {
                      "pendingDelivery": {
                        "const": true
                      }
                    },
                    "required": [
                      "pendingDelivery"
                    ]
                  }
                },
                "required": [
                  "vehicle"
                ]
              },
              "minContains": 0,
              "maxContains": 1
            }
          }
        },
        {
          "if": {
            "properties": {
              "world": {
                "properties": {
                  "position": {
                    "properties": {
                      "location": {
                        "const": 0
                      },
                      "floor": {
                        "const": 0
                      }
                    },
                    "required": [
                      "location",
                      "floor"
                    ]
                  }
                },
                "required": [
                  "position"
                ]
              }
            },
            "required": [
              "world"
            ]
          },
          "then": {
            "properties": {
              "mapUnits": {
                "items": {
                  "not": {
                    "properties": {
                      "vehicle": {
                        "type": "object",
                        "properties": {
                          "pendingDelivery": {
                            "const": true
                          }
                        },
                        "required": [
                          "pendingDelivery"
                        ]
                      }
                    },
                    "required": [
                      "vehicle"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "vehicle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "currentDirection",
        "previousDirection",
        "skiffs",
        "ownedByNpc",
        "hull",
        "sailState",
        "hasHmsCape",
        "pendingDelivery"
      ],
      "properties": {
        "type": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "currentDirection": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "previousDirection": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "skiffs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12
        },
        "ownedByNpc": {
          "type": "boolean"
        },
        "hull": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99
        },
        "sailState": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "hasHmsCape": {
          "type": "boolean"
        },
        "pendingDelivery": {
          "type": "boolean"
        }
      },
      "if": {
        "properties": {
          "type": {
            "const": 4
          }
        },
        "required": [
          "type"
        ]
      },
      "else": {
        "properties": {
          "skiffs": {
            "const": 0
          }
        }
      }
    },
    "mapUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "world",
        "controllerOrder",
        "kind",
        "referenceId",
        "npcNum",
        "position",
        "visible",
        "skipNextTurn",
        "wantsToAutoTalk",
        "overriddenAi",
        "currentPath",
        "vehicle",
        "enemyVariant",
        "enemyCurrentHp",
        "enemyFacing",
        "shadowlord"
      ],
      "properties": {
        "world": {
          "$ref": "native-save-v4.schema.json#/$defs/mapUnit/properties/world"
        },
        "controllerOrder": {
          "$ref": "native-save-v4.schema.json#/$defs/mapUnit/properties/controllerOrder"
        },
        "kind": {
          "$ref": "native-save-v4.schema.json#/$defs/mapUnit/properties/kind"
        },
        "referenceId": {
          "$ref": "native-save-v4.schema.json#/$defs/mapUnit/properties/referenceId"
        },
        "npcNum": {
          "$ref": "native-save-v4.schema.json#/$defs/mapUnit/properties/npcNum"
        },
        "position": {
          "$ref": "native-save-v4.schema.json#/$defs/mapUnit/properties/position"
        },
        "visible": {
          "$ref": "native-save-v4.schema.json#/$defs/mapUnit/properties/visible"
        },
        "skipNextTurn": {
          "$ref": "native-save-v4.schema.json#/$defs/mapUnit/properties/skipNextTurn"
        },
        "wantsToAutoTalk": {
          "$ref": "native-save-v4.schema.json#/$defs/mapUnit/properties/wantsToAutoTalk"
        },
        "overriddenAi": {
          "$ref": "native-save-v4.schema.json#/$defs/mapUnit/properties/overriddenAi"
        },
        "arrivedScheduleSlot": {
          "$ref": "native-save-v4.schema.json#/$defs/mapUnit/properties/arrivedScheduleSlot"
        },
        "consumedTalk3ScheduleSlot": {
          "$ref": "native-save-v4.schema.json#/$defs/mapUnit/properties/consumedTalk3ScheduleSlot"
        },
        "currentPath": {
          "$ref": "native-save-v4.schema.json#/$defs/mapUnit/properties/currentPath"
        },
        "vehicle": {
          "oneOf": [
            {
              "$ref": "#/$defs/vehicle"
            },
            {
              "type": "null"
            }
          ]
        },
        "enemyVariant": {
          "$ref": "native-save-v4.schema.json#/$defs/mapUnit/properties/enemyVariant"
        },
        "enemyCurrentHp": {
          "$ref": "native-save-v4.schema.json#/$defs/mapUnit/properties/enemyCurrentHp"
        },
        "enemyFacing": {
          "$ref": "native-save-v4.schema.json#/$defs/mapUnit/properties/enemyFacing"
        },
        "shadowlord": {
          "$ref": "native-save-v4.schema.json#/$defs/mapUnit/properties/shadowlord"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "vehicle"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "vehicle": {
                "$ref": "#/$defs/vehicle"
              }
            }
          }
        },
        {
          "$ref": "native-save-v4.schema.json#/$defs/mapUnit/allOf/1"
        },
        {
          "if": {
            "properties": {
              "vehicle": {
                "type": "object",
                "properties": {
                  "pendingDelivery": {
                    "const": true
                  }
                },
                "required": [
                  "pendingDelivery"
                ]
              }
            },
            "required": [
              "vehicle"
            ]
          },
          "then": {
            "properties": {
              "world": {
                "const": 0
              },
              "kind": {
                "const": "vehicle"
              },
              "position": {
                "properties": {
                  "location": {
                    "const": 0
                  },
                  "floor": {
                    "const": 0
                  }
                }
              },
              "visible": {
                "const": true
              },
              "vehicle": {
                "properties": {
                  "type": {
                    "enum": [
                      3,
                      4
                    ]
                  },
                  "currentDirection": {
                    "const": 4
                  },
                  "previousDirection": {
                    "const": 4
                  },
                  "ownedByNpc": {
                    "const": false
                  },
                  "hull": {
                    "const": 99
                  },
                  "sailState": {
                    "const": 0
                  },
                  "hasHmsCape": {
                    "const": false
                  }
                },
                "oneOf": [
                  {
                    "properties": {
                      "type": {
                        "const": 4
                      },
                      "skiffs": {
                        "minimum": 2,
                        "maximum": 12
                      }
                    }
                  },
                  {
                    "properties": {
                      "type": {
                        "const": 3
                      },
                      "skiffs": {
                        "const": 0
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/bradhannah/UltimaVRedux/main/docs/schemas/native-save-e2-s23.schema.json",
  "title": "Native Ultima V Redux Save Envelope 2 / Snapshot 23",
  "description": "Load frozen sibling s16-s22 schemas locally and assert the version-aware ultima5-world-journal format. Adds a nullable semantic timed door, one bounded Guardians site and the Greyhaven live sextant receipt authority. Receipt alone permits a truthful strict daytime survey; other survey policy is unchanged. Occupancy openness and map notices are not persisted.",
  "type": "object", "additionalProperties": false,
  "required": ["format", "envelopeVersion", "metadata", "snapshot"],
  "properties": {
    "format": {"const": "ultima5redux-native-snapshot"}, "envelopeVersion": {"const": 2},
    "metadata": {"$ref": "native-save-e2-s22.schema.json#/properties/metadata"},
    "snapshot": {"$ref": "#/$defs/snapshot"}
  },
  "$defs": {
    "snapshot": {
      "type": "object", "additionalProperties": false, "format": "ultima5-world-journal",
      "required": ["version", "party", "inventory", "world", "progression", "effects", "wind", "random", "continuation", "redux", "presentation", "lastConversation", "dungeonJournal", "moonstoneJournal", "atlasLandmarks", "dungeon", "partyVehicle", "mapUnits", "itemStacks", "mapMutations", "openDoor"],
      "properties": {
        "version": {"const": 23},
        "party": {"$ref": "native-save-e2-s22.schema.json#/$defs/snapshot/properties/party"},
        "inventory": {"$ref": "native-save-e2-s22.schema.json#/$defs/snapshot/properties/inventory"},
        "world": {"$ref": "native-save-e2-s22.schema.json#/$defs/snapshot/properties/world"},
        "progression": {"$ref": "native-save-e2-s22.schema.json#/$defs/snapshot/properties/progression"},
        "effects": {"$ref": "native-save-e2-s22.schema.json#/$defs/snapshot/properties/effects"},
        "wind": {"$ref": "native-save-e2-s22.schema.json#/$defs/snapshot/properties/wind"},
        "random": {"$ref": "native-save-e2-s22.schema.json#/$defs/snapshot/properties/random"},
        "continuation": {"$ref": "native-save-e2-s22.schema.json#/$defs/snapshot/properties/continuation"},
        "redux": {"$ref": "native-save-e2-s22.schema.json#/$defs/snapshot/properties/redux"},
        "presentation": {"$ref": "native-save-e2-s22.schema.json#/$defs/snapshot/properties/presentation"},
        "lastConversation": {"$ref": "native-save-e2-s22.schema.json#/$defs/snapshot/properties/lastConversation"},
        "dungeonJournal": {"$ref": "native-save-e2-s22.schema.json#/$defs/snapshot/properties/dungeonJournal"},
        "moonstoneJournal": {"$ref": "native-save-e2-s22.schema.json#/$defs/snapshot/properties/moonstoneJournal"},
        "atlasLandmarks": {"type": ["array", "null"], "maxItems": 39, "items": {"$ref": "#/$defs/atlasLandmark"}},
        "dungeon": {"$ref": "native-save-e2-s22.schema.json#/$defs/snapshot/properties/dungeon"},
        "partyVehicle": {"$ref": "native-save-e2-s22.schema.json#/$defs/snapshot/properties/partyVehicle"},
        "mapUnits": {"$ref": "native-save-e2-s22.schema.json#/$defs/snapshot/properties/mapUnits"},
        "itemStacks": {"$ref": "native-save-e2-s22.schema.json#/$defs/snapshot/properties/itemStacks"},
        "mapMutations": {"$ref": "native-save-e2-s22.schema.json#/$defs/snapshot/properties/mapMutations"},
        "openDoor": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/openDoor"}]}
      },
      "allOf": [
        {"$ref": "native-save-e2-s22.schema.json#/$defs/snapshot/allOf/0"},
        {"$ref": "native-save-e2-s22.schema.json#/$defs/snapshot/allOf/1"},
        {"$ref": "native-save-e2-s22.schema.json#/$defs/snapshot/allOf/2"},
        {"$ref": "native-save-e2-s22.schema.json#/$defs/snapshot/allOf/3"},
        {"$ref": "native-save-e2-s22.schema.json#/$defs/snapshot/allOf/4"},
        {"$ref": "native-save-e2-s22.schema.json#/$defs/snapshot/allOf/5"},
        {"$ref": "native-save-e2-s22.schema.json#/$defs/snapshot/allOf/6"},
        {"$ref": "native-save-e2-s22.schema.json#/$defs/snapshot/allOf/7"},
        {"$ref": "native-save-e2-s22.schema.json#/$defs/snapshot/allOf/8"},
        {"$ref": "native-save-e2-s22.schema.json#/$defs/snapshot/allOf/9"},
        {"$ref": "native-save-e2-s22.schema.json#/$defs/snapshot/allOf/10"}
      ]
    },
    "openDoor": {
      "type": "object", "additionalProperties": false,
      "required": ["position", "remainingTurns", "closedTile"],
      "properties": {
        "position": {
          "type": "object", "additionalProperties": false, "required": ["location", "x", "y", "floor"],
          "properties": {
            "location": {"type": "integer", "minimum": 1, "maximum": 32},
            "x": {"type": "integer", "minimum": 0, "maximum": 31},
            "y": {"type": "integer", "minimum": 0, "maximum": 31},
            "floor": {"type": "integer", "minimum": -1, "maximum": 3}
          }
        },
        "remainingTurns": {"type": "integer", "minimum": 0, "maximum": 2},
        "closedTile": {"enum": [184, 186]}
      }
    },
    "atlasLandmark": {
      "type": "object", "additionalProperties": false,
      "required": ["siteKey", "site", "kind", "name", "source", "nameSource", "observedAt", "namedAt", "survey", "surveySource"],
      "properties": {
        "siteKey": {"type": "integer", "anyOf": [{"minimum": 1, "maximum": 32, "not": {"const": 25}}, {"minimum": 101, "maximum": 108}]},
        "site": {"$ref": "native-save-e2-s20.schema.json#/$defs/site"},
        "kind": {"enum": ["towne", "village", "hut", "keep", "castle", "lighthouse", "shrine", "ruins", "guardians"]},
        "name": {"$ref": "native-save-e2-s20.schema.json#/$defs/atlasLandmark/properties/name"},
        "source": {"enum": ["look", "enter", "shrine-introduction", "sextant-receipt"]},
        "nameSource": {"$ref": "native-save-e2-s20.schema.json#/$defs/atlasLandmark/properties/nameSource"},
        "observedAt": {"$ref": "native-save-e2-s20.schema.json#/$defs/optionalTime"},
        "namedAt": {"$ref": "native-save-e2-s20.schema.json#/$defs/optionalTime"},
        "survey": {"$ref": "native-save-e2-s22.schema.json#/$defs/survey"},
        "surveySource": {"enum": ["", "look", "enter", "shrine-introduction", "sextant-receipt"]}
      }
    }
  }
}

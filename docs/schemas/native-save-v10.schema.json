{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/bradhannah/UltimaVRedux/main/docs/schemas/native-save-v10.schema.json",
  "title": "Native Ultima V Redux Save Schema",
  "description": "Strict native Ultima V Redux save envelope containing SaveSnapshot version 10, including durable Lord British passage state.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "envelopeVersion", "metadata", "snapshot"],
  "properties": {
    "format": {"const": "ultima5redux-native-snapshot"},
    "envelopeVersion": {"const": 1},
    "metadata": {
      "$ref": "native-save-v3.schema.json#/$defs/metadata"
    },
    "snapshot": {"$ref": "#/$defs/saveSnapshot"}
  },
  "$defs": {
    "saveSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version", "party", "inventory", "world", "progression", "effects", "wind", "random",
        "redux", "dungeon", "partyVehicle", "mapUnits", "itemStacks", "mapMutations"
      ],
      "properties": {
        "version": {"const": 10},
        "party": {"$ref": "native-save-v9.schema.json#/$defs/saveSnapshot/properties/party"},
        "inventory": {"$ref": "native-save-v9.schema.json#/$defs/saveSnapshot/properties/inventory"},
        "world": {"$ref": "native-save-v9.schema.json#/$defs/saveSnapshot/properties/world"},
        "progression": {"$ref": "native-save-v9.schema.json#/$defs/saveSnapshot/properties/progression"},
        "effects": {"$ref": "native-save-v9.schema.json#/$defs/saveSnapshot/properties/effects"},
        "wind": {"$ref": "native-save-v9.schema.json#/$defs/saveSnapshot/properties/wind"},
        "random": {"$ref": "native-save-v9.schema.json#/$defs/saveSnapshot/properties/random"},
        "redux": {"$ref": "#/$defs/redux"},
        "dungeon": {"$ref": "native-save-v9.schema.json#/$defs/saveSnapshot/properties/dungeon"},
        "partyVehicle": {"$ref": "native-save-v9.schema.json#/$defs/saveSnapshot/properties/partyVehicle"},
        "mapUnits": {"$ref": "native-save-v9.schema.json#/$defs/saveSnapshot/properties/mapUnits"},
        "itemStacks": {"$ref": "native-save-v9.schema.json#/$defs/saveSnapshot/properties/itemStacks"},
        "mapMutations": {"$ref": "native-save-v9.schema.json#/$defs/saveSnapshot/properties/mapMutations"}
      },
      "allOf": [
        {"$ref": "native-save-v9.schema.json#/$defs/saveSnapshot/allOf/0"},
        {"$ref": "native-save-v9.schema.json#/$defs/saveSnapshot/allOf/1"},
        {"$ref": "native-save-v9.schema.json#/$defs/saveSnapshot/allOf/2"},
        {"$ref": "native-save-v9.schema.json#/$defs/saveSnapshot/allOf/3"},
        {"$ref": "native-save-v9.schema.json#/$defs/saveSnapshot/allOf/4"},
        {"$ref": "native-save-v9.schema.json#/$defs/saveSnapshot/allOf/5"},
        {"$ref": "native-save-v9.schema.json#/$defs/saveSnapshot/allOf/6"},
        {"$ref": "native-save-v9.schema.json#/$defs/saveSnapshot/allOf/7"},
        {"$ref": "native-save-v9.schema.json#/$defs/saveSnapshot/allOf/8"},
        {"$ref": "native-save-v9.schema.json#/$defs/saveSnapshot/allOf/9"},
        {"$ref": "native-save-v9.schema.json#/$defs/saveSnapshot/allOf/10"},
        {"$ref": "native-save-v9.schema.json#/$defs/saveSnapshot/allOf/11"}
      ]
    },
    "redux": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reconstructMapUnits", "dungeonDiscoveries", "playerKnowledge", "questJournal",
        "lordBritishPassageOpen"
      ],
      "properties": {
        "reconstructMapUnits": {"$ref": "native-save-v9.schema.json#/$defs/redux/properties/reconstructMapUnits"},
        "dungeonDiscoveries": {"$ref": "native-save-v9.schema.json#/$defs/redux/properties/dungeonDiscoveries"},
        "playerKnowledge": {"$ref": "native-save-v9.schema.json#/$defs/redux/properties/playerKnowledge"},
        "questJournal": {"$ref": "native-save-v9.schema.json#/$defs/redux/properties/questJournal"},
        "lordBritishPassageOpen": {"type": "boolean"}
      }
    }
  }
}

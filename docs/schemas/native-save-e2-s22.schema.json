{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/bradhannah/UltimaVRedux/main/docs/schemas/native-save-e2-s22.schema.json",
  "title": "Native Ultima V Redux Save Envelope 2 / Snapshot 22",
  "description": "Load frozen sibling s16-s21 schemas locally. Assert journal formats with version-aware Go validators. Every survey now requires flexible measurement-policy provenance; original-policy surveys remain nighttime-only and all measured locations remain Britannia surface. User configuration is not persisted measurement authority.",
  "type": "object", "additionalProperties": false,
  "required": ["format", "envelopeVersion", "metadata", "snapshot"],
  "properties": {
    "format": {"const": "ultima5redux-native-snapshot"}, "envelopeVersion": {"const": 2},
    "metadata": {"$ref": "native-save-e2-s21.schema.json#/properties/metadata"},
    "snapshot": {"$ref": "#/$defs/snapshot"}
  },
  "$defs": {
    "snapshot": {
      "type": "object", "additionalProperties": false, "format": "ultima5-world-journal",
      "required": ["version", "party", "inventory", "world", "progression", "effects", "wind", "random", "continuation", "redux", "presentation", "lastConversation", "dungeonJournal", "moonstoneJournal", "atlasLandmarks", "dungeon", "partyVehicle", "mapUnits", "itemStacks", "mapMutations"],
      "properties": {
        "version": {"const": 22},
        "party": {"$ref": "native-save-e2-s21.schema.json#/$defs/snapshot/properties/party"},
        "inventory": {"$ref": "native-save-e2-s21.schema.json#/$defs/snapshot/properties/inventory"},
        "world": {"$ref": "native-save-e2-s21.schema.json#/$defs/snapshot/properties/world"},
        "progression": {"$ref": "native-save-e2-s21.schema.json#/$defs/snapshot/properties/progression"},
        "effects": {"$ref": "native-save-e2-s21.schema.json#/$defs/snapshot/properties/effects"},
        "wind": {"$ref": "native-save-e2-s21.schema.json#/$defs/snapshot/properties/wind"},
        "random": {"$ref": "native-save-e2-s21.schema.json#/$defs/snapshot/properties/random"},
        "continuation": {"$ref": "native-save-e2-s21.schema.json#/$defs/snapshot/properties/continuation"},
        "redux": {"$ref": "native-save-e2-s21.schema.json#/$defs/snapshot/properties/redux"},
        "presentation": {"$ref": "native-save-e2-s21.schema.json#/$defs/snapshot/properties/presentation"},
        "lastConversation": {"$ref": "native-save-e2-s21.schema.json#/$defs/snapshot/properties/lastConversation"},
        "dungeonJournal": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"$ref": "#/$defs/dungeonObservation"}},
        "moonstoneJournal": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"$ref": "#/$defs/moonstoneObservation"}},
        "atlasLandmarks": {"type": ["array", "null"], "maxItems": 38, "items": {"$ref": "#/$defs/atlasLandmark"}},
        "dungeon": {"$ref": "native-save-e2-s21.schema.json#/$defs/snapshot/properties/dungeon"},
        "partyVehicle": {"$ref": "native-save-e2-s21.schema.json#/$defs/snapshot/properties/partyVehicle"},
        "mapUnits": {"$ref": "native-save-e2-s21.schema.json#/$defs/snapshot/properties/mapUnits"},
        "itemStacks": {"$ref": "native-save-e2-s21.schema.json#/$defs/snapshot/properties/itemStacks"},
        "mapMutations": {"$ref": "native-save-e2-s21.schema.json#/$defs/snapshot/properties/mapMutations"}
      },
      "allOf": [
        {"$ref": "native-save-e2-s21.schema.json#/$defs/snapshot/allOf/0"},
        {"$ref": "native-save-e2-s21.schema.json#/$defs/snapshot/allOf/1"},
        {"$ref": "native-save-e2-s21.schema.json#/$defs/snapshot/allOf/2"},
        {"$ref": "native-save-e2-s21.schema.json#/$defs/snapshot/allOf/3"},
        {"$ref": "native-save-e2-s21.schema.json#/$defs/snapshot/allOf/4"},
        {"$ref": "native-save-e2-s21.schema.json#/$defs/snapshot/allOf/5"},
        {"$ref": "native-save-e2-s21.schema.json#/$defs/snapshot/allOf/6"},
        {"$ref": "native-save-e2-s21.schema.json#/$defs/snapshot/allOf/7"},
        {"$ref": "native-save-e2-s21.schema.json#/$defs/snapshot/allOf/8"},
        {"$ref": "native-save-e2-s21.schema.json#/$defs/snapshot/allOf/9"},
        {"$ref": "native-save-e2-s21.schema.json#/$defs/snapshot/allOf/10"}
      ]
    },
    "survey": {
      "type": "object", "additionalProperties": false,
      "required": ["measured", "flexible", "location", "recordedAt"],
      "properties": {
        "measured": {"type": "boolean"}, "flexible": {"type": "boolean"},
        "location": {"$ref": "native-save-e2-s20.schema.json#/$defs/site"},
        "recordedAt": {"$ref": "native-save-e2-s20.schema.json#/$defs/optionalTime"}
      }
    },
    "dungeonSite": {
      "type": "object", "additionalProperties": false,
      "required": ["seen", "location", "open", "observedAt", "survey"],
      "properties": {
        "seen": {"type": "boolean"}, "open": {"type": "boolean"},
        "location": {"$ref": "native-save-e2-s20.schema.json#/$defs/site"},
        "observedAt": {"$ref": "native-save-e2-s20.schema.json#/$defs/optionalTime"},
        "survey": {"$ref": "#/$defs/survey"}
      }
    },
    "dungeonObservation": {
      "type": "object", "additionalProperties": false, "required": ["known", "wordUsed", "sites"],
      "properties": {
        "known": {"type": "boolean"}, "wordUsed": {"type": "boolean"},
        "sites": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/dungeonSite"}}
      }
    },
    "atlasLandmark": {
      "type": "object", "additionalProperties": false,
      "required": ["siteKey", "site", "kind", "name", "source", "nameSource", "observedAt", "namedAt", "survey", "surveySource"],
      "properties": {
        "siteKey": {"$ref": "native-save-e2-s20.schema.json#/$defs/atlasLandmark/properties/siteKey"},
        "site": {"$ref": "native-save-e2-s20.schema.json#/$defs/site"},
        "kind": {"$ref": "native-save-e2-s20.schema.json#/$defs/atlasLandmark/properties/kind"},
        "name": {"$ref": "native-save-e2-s20.schema.json#/$defs/atlasLandmark/properties/name"},
        "source": {"$ref": "native-save-e2-s20.schema.json#/$defs/atlasLandmark/properties/source"},
        "nameSource": {"$ref": "native-save-e2-s20.schema.json#/$defs/atlasLandmark/properties/nameSource"},
        "observedAt": {"$ref": "native-save-e2-s20.schema.json#/$defs/optionalTime"},
        "namedAt": {"$ref": "native-save-e2-s20.schema.json#/$defs/optionalTime"},
        "survey": {"$ref": "#/$defs/survey"},
        "surveySource": {"$ref": "native-save-e2-s20.schema.json#/$defs/atlasLandmark/properties/surveySource"}
      }
    },
    "moonstoneObservation": {
      "type": "object", "additionalProperties": false,
      "required": ["known", "firstSource", "discoveredAt", "siteKnown", "site", "placed", "lastContext", "observedAt", "survey", "surveyContext", "originalSiteRetired"],
      "properties": {
        "known": {"type": "boolean"}, "originalSiteRetired": {"type": "boolean"},
        "firstSource": {"$ref": "native-save-e2-s20.schema.json#/$defs/moonstoneSource"},
        "discoveredAt": {"$ref": "native-save-e2-s20.schema.json#/$defs/optionalTime"},
        "siteKnown": {"type": "boolean"}, "placed": {"type": "boolean"},
        "site": {"$ref": "native-save-e2-s20.schema.json#/$defs/site"},
        "lastContext": {"$ref": "native-save-e2-s20.schema.json#/$defs/moonstoneContext"},
        "observedAt": {"$ref": "native-save-e2-s20.schema.json#/$defs/optionalTime"},
        "survey": {"$ref": "#/$defs/survey"},
        "surveyContext": {"$ref": "native-save-e2-s20.schema.json#/$defs/moonstoneContext"}
      }
    }
  }
}

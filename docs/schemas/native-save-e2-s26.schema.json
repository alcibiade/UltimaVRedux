{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/bradhannah/UltimaVRedux/main/docs/schemas/native-save-e2-s26.schema.json",
  "title": "Native Ultima V Redux Save Envelope 2 / Snapshot 26",
  "description": "Load frozen sibling s16-s25 schemas locally and assert the version-aware ultima5-world-journal format. V26 adds the optional Redux crafting extension (ref:CRAFT-0001): material and tool stock, land claims, placed build pieces with the tile each covered, and home chest contents. Placed tiles themselves remain ordinary mapMutations.",
  "type": "object", "additionalProperties": false,
  "required": ["format", "envelopeVersion", "metadata", "snapshot"],
  "properties": {
    "format": {"const": "ultima5redux-native-snapshot"}, "envelopeVersion": {"const": 2},
    "metadata": {"$ref": "native-save-e2-s25.schema.json#/properties/metadata"},
    "snapshot": {"$ref": "#/$defs/snapshot"}
  },
  "$defs": {
    "snapshot": {
      "type": "object", "additionalProperties": false, "format": "ultima5-world-journal",
      "required": ["version", "party", "inventory", "world", "progression", "effects", "wind", "random", "continuation", "redux", "presentation", "lastConversation", "excerpts", "dungeonJournal", "moonstoneJournal", "atlasLandmarks", "dungeon", "partyVehicle", "mapUnits", "itemStacks", "mapMutations", "openDoor", "basementChestHistory", "atlasNotes", "atlasFleet", "codexRevelationComplete", "crafting"],
      "properties": {
        "version": {"const": 26},
        "party": {"$ref": "native-save-e2-s25.schema.json#/$defs/snapshot/properties/party"},
        "inventory": {"$ref": "native-save-e2-s25.schema.json#/$defs/snapshot/properties/inventory"},
        "world": {"$ref": "native-save-e2-s25.schema.json#/$defs/snapshot/properties/world"},
        "progression": {"$ref": "native-save-e2-s25.schema.json#/$defs/snapshot/properties/progression"},
        "effects": {"$ref": "native-save-e2-s25.schema.json#/$defs/snapshot/properties/effects"},
        "wind": {"$ref": "native-save-e2-s25.schema.json#/$defs/snapshot/properties/wind"},
        "random": {"$ref": "native-save-e2-s25.schema.json#/$defs/snapshot/properties/random"},
        "continuation": {"$ref": "native-save-e2-s25.schema.json#/$defs/snapshot/properties/continuation"},
        "redux": {"$ref": "native-save-e2-s25.schema.json#/$defs/snapshot/properties/redux"},
        "presentation": {"$ref": "native-save-e2-s25.schema.json#/$defs/snapshot/properties/presentation"},
        "lastConversation": {"$ref": "native-save-e2-s25.schema.json#/$defs/snapshot/properties/lastConversation"},
        "excerpts": {"$ref": "native-save-e2-s25.schema.json#/$defs/snapshot/properties/excerpts"},
        "dungeonJournal": {"$ref": "native-save-e2-s25.schema.json#/$defs/snapshot/properties/dungeonJournal"},
        "moonstoneJournal": {"$ref": "native-save-e2-s25.schema.json#/$defs/snapshot/properties/moonstoneJournal"},
        "atlasLandmarks": {"$ref": "native-save-e2-s25.schema.json#/$defs/snapshot/properties/atlasLandmarks"},
        "dungeon": {"$ref": "native-save-e2-s25.schema.json#/$defs/snapshot/properties/dungeon"},
        "partyVehicle": {"$ref": "native-save-e2-s25.schema.json#/$defs/snapshot/properties/partyVehicle"},
        "mapUnits": {"$ref": "native-save-e2-s25.schema.json#/$defs/snapshot/properties/mapUnits"},
        "itemStacks": {"$ref": "native-save-e2-s25.schema.json#/$defs/snapshot/properties/itemStacks"},
        "mapMutations": {"$ref": "native-save-e2-s25.schema.json#/$defs/snapshot/properties/mapMutations"},
        "openDoor": {"$ref": "native-save-e2-s25.schema.json#/$defs/snapshot/properties/openDoor"},
        "basementChestHistory": {"$ref": "native-save-e2-s25.schema.json#/$defs/snapshot/properties/basementChestHistory"},
        "atlasNotes": {"$ref": "native-save-e2-s25.schema.json#/$defs/snapshot/properties/atlasNotes"},
        "atlasFleet": {"$ref": "native-save-e2-s25.schema.json#/$defs/snapshot/properties/atlasFleet"},
        "codexRevelationComplete": {"type": "boolean"},
        "crafting": {"$ref": "#/$defs/crafting"}
      },
      "allOf": [
        {"$ref": "native-save-e2-s25.schema.json#/$defs/snapshot/allOf/0"},
        {"$ref": "native-save-e2-s25.schema.json#/$defs/snapshot/allOf/1"},
        {"$ref": "native-save-e2-s25.schema.json#/$defs/snapshot/allOf/2"},
        {"$ref": "native-save-e2-s25.schema.json#/$defs/snapshot/allOf/3"},
        {"$ref": "native-save-e2-s25.schema.json#/$defs/snapshot/allOf/4"},
        {"$ref": "native-save-e2-s25.schema.json#/$defs/snapshot/allOf/5"},
        {"$ref": "native-save-e2-s25.schema.json#/$defs/snapshot/allOf/6"},
        {"$ref": "native-save-e2-s25.schema.json#/$defs/snapshot/allOf/7"},
        {"$ref": "native-save-e2-s25.schema.json#/$defs/snapshot/allOf/8"},
        {"$ref": "native-save-e2-s25.schema.json#/$defs/snapshot/allOf/9"},
        {"$ref": "native-save-e2-s25.schema.json#/$defs/snapshot/allOf/10"}
      ]
    },
    "quantityLarge": {"type": "integer", "minimum": 0, "maximum": 9999},
    "quantitySmall": {"type": "integer", "minimum": 0, "maximum": 99},
    "coordinate": {"type": "integer", "minimum": 0, "maximum": 255},
    "materials": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/quantityLarge"}},
    "tools": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/quantitySmall"}},
    "crafting": {
      "type": "object", "additionalProperties": false,
      "required": ["materials", "tools", "landClaims", "placements", "homeChests"],
      "properties": {
        "materials": {"$ref": "#/$defs/materials"},
        "tools": {"$ref": "#/$defs/tools"},
        "landClaims": {"type": ["array", "null"], "maxItems": 4, "items": {"$ref": "#/$defs/landClaim"}},
        "placements": {"type": ["array", "null"], "maxItems": 4096, "items": {"$ref": "#/$defs/placement"}},
        "homeChests": {"type": ["array", "null"], "maxItems": 4096, "items": {"$ref": "#/$defs/homeChest"}}
      }
    },
    "landClaim": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "x", "y", "width", "height"],
      "properties": {
        "id": {"type": "integer", "minimum": 0},
        "name": {"type": "string", "pattern": "^[!-~](?:[ -~]{0,22}[!-~])?$"},
        "x": {"$ref": "#/$defs/coordinate"}, "y": {"$ref": "#/$defs/coordinate"},
        "width": {"const": 16}, "height": {"const": 16}
      }
    },
    "placement": {
      "type": "object", "additionalProperties": false,
      "required": ["x", "y", "pieceId", "under"],
      "properties": {
        "x": {"$ref": "#/$defs/coordinate"}, "y": {"$ref": "#/$defs/coordinate"},
        "pieceId": {"type": "integer", "minimum": 0, "maximum": 22},
        "under": {"type": "integer", "minimum": 0, "maximum": 255}
      }
    },
    "homeChest": {
      "type": "object", "additionalProperties": false,
      "required": ["x", "y", "materials", "tools", "provisions"],
      "properties": {
        "x": {"$ref": "#/$defs/coordinate"}, "y": {"$ref": "#/$defs/coordinate"},
        "materials": {"$ref": "#/$defs/materials"},
        "tools": {"$ref": "#/$defs/tools"},
        "provisions": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/quantityLarge"}}
      }
    }
  }
}
